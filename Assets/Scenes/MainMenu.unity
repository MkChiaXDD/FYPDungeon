--- !u!114 &1296550697
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1296550695}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 98fbeccfe4a775b469da4039d19d0d51, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  funFacts:
  - factText: 'This XFZ TROLLING BRO

'
    optionalImage: {fileID: 0}
  - factText: A raccoon's touch is their most powerful sense, gets stronger while
      their hands are wet
    optionalImage: {fileID: 0}
  - factText: The word "raccoon" is from the Powhatan, meaning "he scratches with
      the hands."
    optionalImage: {fileID: 0}
  - factText: A group of raccoons is called a nursery or a gaze.
    optionalImage: {fileID: 0}
  - factText: Raccoon masks reduce glare, which allows raccoons to see more clearly
      at night. Some raccoons that live in coastal areas have white masks, which
      is a genetic mutation.
    optionalImage: {fileID: 0}
  - factText: Raccoon babies are called kits.
    optionalImage: {fileID: 0}
  - factText: Raccoons can rotate their hind feet backwards to help them climb down
      trees head-first.
    optionalImage: {fileID: 0}
  - factText: "US President Calvin Coolidge had a pet raccoon in the White House
      named Rebecca. She was a regular at White House events and even had an engraved
      collar that said, \u201CWhite House Raccoon\u201D."
    optionalImage: {fileID: 0}
  displayDuration: 2
  factTextComponent: {fileID: 1296550698}
  factImageComponent: {fileID: 0}
